# QuietGuard optional local secrets
# Copy to %LOCALAPPDATA%\QuietGuard\secrets.conf only when you want keyed services.
# Never commit the real file or keys to GitHub.

# One abuse.ch Auth-Key enables both ThreatFox and URLhaus optional caches.
abusech_auth_key=

# Google Safe Browsing is implemented but intentionally opt-in because checked raw URLs are sent to Google.
google_safe_browsing_key=
google_safe_browsing_enabled=false

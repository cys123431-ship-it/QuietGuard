# QuietGuard optional local secrets
# Copy to %LOCALAPPDATA%\QuietGuard\secrets.conf only if you later want keyed services.
# Never commit the real file or keys to GitHub.

# One free abuse.ch Auth-Key enables both ThreatFox and URLhaus optional caches.
abusech_auth_key=

# Reserved for a future opt-in Google Safe Browsing adapter.
google_safe_browsing_key=
google_safe_browsing_enabled=false
